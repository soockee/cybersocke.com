package components

type NavItem struct {
	Name string
	URL  string
}

func NewNavItem(name string, URL string) NavItem {
	return NavItem{
		Name: name,
		URL:  URL,
	}
}

templ layout(name string, navprops NavBarProps) {
	<!DOCTYPE html>
	<html lang="en">
		@Header(name)
		<body>
			@navTemplate(navprops)
			<main>
				{ children... }
			</main>
		</body>
		@Footer()
	</html>
}
