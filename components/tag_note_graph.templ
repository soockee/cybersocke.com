package components

import (
	"github.com/soockee/cybersocke.com/storage/models"
	"strconv"
	"strings"
)

type TagNoteGraphProps struct {
	Posts     map[string]*models.Post
	TagCounts map[string]int
	Authed    bool
	Filters   GraphFilterInfo
	User      *NavUser
}

type GraphFilterInfo struct {
	IncludeTags   []string
	MinSharedTags int
	MaxEdges      int
	PostCount     int
	TagCount      int
	HasFilter     bool
}

// TagNoteGraph renders hidden data spans and Cytoscape container for bipartite graph.
templ TagNoteGraph(p TagNoteGraphProps) {
	@layout("Graph", BuildNavProps(p.Authed, p.User)) {
		<div class="tag-note-graph-wrapper">
			<h1>Knowledge Graph</h1>
			<div class="tag-note-graph-context" aria-live="polite">
				if p.Filters.PostCount == 0 {
					<p>No posts match the current graph filter.</p>
					if len(p.Filters.IncludeTags) > 0 {
						<p>Filters applied:</p>
						<ul class="graph-filter-chip-list">
							for _, tag := range p.Filters.IncludeTags {
								<li><span class="graph-filter-chip">{ tag }</span></li>
							}
						</ul>
					}
					<a class="graph-filter-reset" href="/graph">View full graph</a>
				} else if p.Filters.HasFilter {
					<p>
						Showing <strong>{ strconv.Itoa(p.Filters.PostCount) }</strong> posts across
						<strong>{ strconv.Itoa(p.Filters.TagCount) }</strong> tags filtered to:
					</p>
					if len(p.Filters.IncludeTags) > 0 {
						<ul class="graph-filter-chip-list">
							for _, tag := range p.Filters.IncludeTags {
								<li><span class="graph-filter-chip">{ tag }</span></li>
							}
						</ul>
					}
					<a class="graph-filter-reset" href="/graph">Reset filters</a>
				} else {
					<p>
						Showing full knowledge graph with <strong>{ strconv.Itoa(p.Filters.PostCount) }</strong> posts and
						<strong>{ strconv.Itoa(len(p.TagCounts)) }</strong> tags.
					</p>
				}
			</div>
			<div id="tag-note-cy" class="tag-note-cy" data-mode="tag-note" data-filter-tags={ strings.Join(p.Filters.IncludeTags, ",") } data-filter-active={ strconv.FormatBool(p.Filters.HasFilter) } data-post-count={ strconv.Itoa(p.Filters.PostCount) } data-tag-count={ strconv.Itoa(len(p.TagCounts)) } style="width:100%;height:600px" role="application" aria-label="Tag to note relationship graph"></div>
			<div class="tag-note-data" style="display:none">
				for tag, count := range p.TagCounts {
					<span class="tag-node" data-tag={ tag } data-weight={ count }></span>
				}
				for _, post := range p.Posts {
					<span class="note-node" data-slug={ post.Meta.Slug } data-name={ post.Meta.Name } data-tags={ strings.Join(post.Meta.Tags, " ") } data-weight={ len(post.Meta.Tags) }></span>
				}
			</div>
			<script defer src="/assets/js/cytoscape/3.33.1-cytoscape.min.js"></script>
			<script defer src="/assets/js/cytoscape/2.0.1-layout-base.js"></script>
			<script defer src="/assets/js/cytoscape/2.2.0-cose-base.js"></script>
			<script defer src="/assets/js/cytoscape/2.2.0-fcose.js"></script>
			<script defer src="/assets/js/graph_theme.js"></script>
			<script defer src="/assets/js/tag_note_graph.js"></script>
		</div>
	}
}
